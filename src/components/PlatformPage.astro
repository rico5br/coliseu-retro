---
interface Game {
  title: string;
  description: string;
  href: string;
  image?: string;
}

interface Props {
  title: string;
  description: string;
  games: Game[];
}

const { title, description, games } = Astro.props;
---

<main class="platform-page">

  <header class="platform-header">

  <a href="/" class="platform-logo">
    <img
      src="/logo.png"
      alt="Coliseu Retrô"
    />
  </a>

  <a href="/" class="back-link">← Voltar para a página inicial</a>

  <h1>{title}</h1>

  <p>{description}</p>

</header>

  <section class="games-section" data-pagefind-ignore>
    <h2>Jogos</h2>

    {
      games.length > 0 ? (
        <div class="games-grid">

          {games.map((game) => (
            <a href={game.href} class="game-card">

              {game.image && (
                <img
                  src={game.image}
                  alt={game.title}
                  class="game-image"
                />
              )}

              <div class="game-info">
                <h3>{game.title}</h3>
                <p>{game.description}</p>
              </div>

            </a>
          ))}

        </div>
      ) : (
        <div class="empty-state">
          <h3>Em breve</h3>
          <p>
            Estamos preparando os conteúdos desta plataforma.
          </p>
        </div>
      )
    }

  </section>

</main>

<style>
  .platform-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 50px 20px 80px;
  }

  .platform-header {
  text-align: center;
  margin-bottom: 50px;
}

.platform-logo {
  display: block;
  width: fit-content;
  margin: 0 auto 20px;
}

.platform-logo img {
  width: 180px;
  height: auto;
  display: block;
  transition: transform 0.2s ease;
}

.platform-logo:hover img {
  transform: scale(1.04);
}

.back-link {
  display: block;
  width: fit-content;
  margin: 0 auto 30px;

  color: #00eaff;
  text-decoration: none;

  transition: color 0.2s ease;
}

.back-link:hover {
  color: #ff00ff;
  text-decoration: underline;
}
  .platform-header h1 {
    margin: 0 0 12px;

    color: #00eaff;
    font-size: 2.5rem;

    text-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
  }

  .platform-header p {
    margin: 0;

    color: #9ca3af;
    font-size: 1.05rem;
  }

  .games-section {
    text-align: left;
  }

  .games-section h2 {
    margin-bottom: 25px;
    padding-bottom: 10px;

    border-bottom: 2px solid #6b21a8;

    color: #ffffff;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(260px, 1fr)
    );

    gap: 20px;
  }

  .game-card {
    display: flex;
    flex-direction: column;

    overflow: hidden;

    background: rgba(107, 33, 168, 0.08);

    border: 1px solid #6b21a8;
    border-radius: 10px;

    text-decoration: none;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .game-card:hover {
    transform: translateY(-4px);

    border-color: #06b6d4;

    box-shadow:
      0 0 15px rgba(6, 182, 212, 0.2);
  }

  .game-image {
    display: block;

    width: 100%;
    height: 180px;

    object-fit: cover;
  }

  .game-info {
    padding: 18px;
  }

  .game-info h3 {
    margin: 0 0 8px;

    color: #06b6d4;
    font-size: 1.1rem;
  }

  .game-info p {
    margin: 0;

    color: #9ca3af;

    font-size: 0.9rem;
    line-height: 1.5;
  }

  .empty-state {
    padding: 50px 20px;

    text-align: center;

    background: rgba(107, 33, 168, 0.06);

    border: 1px dashed #6b21a8;
    border-radius: 10px;
  }

  .empty-state h3 {
    margin-bottom: 10px;

    color: #06b6d4;
  }

  .empty-state p {
    margin: 0;

    color: #9ca3af;
  }

  @media (max-width: 600px) {
    .platform-page {
      padding: 35px 15px 60px;
    }

    .platform-header h1 {
      font-size: 2rem;
    }

    .games-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
