---
// src/components/SearchBar.astro
---

<!-- Wrapper adicionado para manter o menu flutuante ancorado à barra -->
<div class="search-wrapper">
  <div class="search-container">
    <input 
      type="text" 
      id="search-input" 
      placeholder="Buscar" 
      class="neon-search"
      autocomplete="off"
    />
    <button class="search-btn" aria-label="Buscar">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>

  <!-- Caixa flutuante -->
  <div id="search-results" class="results-container"></div>
</div>

<script src="/search.js" is:inline></script>
<style>
  /* Novo Wrapper para organizar os elementos absolutos */
  .search-wrapper {
    position: relative;
    max-width: 400px;
    margin: 0 auto;
  }

  .search-container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .neon-search {
    width: 100%;
    padding: 12px 20px;
    padding-right: 45px;
    background-color: transparent;
    border: 2px solid #6b21a8;
    border-radius: 8px;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(107, 33, 168, 0.4), inset 0 0 5px rgba(107, 33, 168, 0.2);
  }

  .neon-search:focus {
    border-color: #06b6d4;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.5), inset 0 0 8px rgba(6, 182, 212, 0.3);
  }

  .neon-search::placeholder {
    color: #9ca3af;
  }

  .search-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: #6b21a8;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .neon-search:focus + .search-btn {
    color: #06b6d4;
  }

  /* Melhorias na caixinha de resultados */
  .results-container {
    display: none; /* Escondido até haver resultados */
    width: 100%;
    margin-top: 10px;
    text-align: left;
    background: #0a0b10;
    border: 1px solid #6b21a8;
    border-radius: 8px;
    position: absolute;
    top: 100%; /* Gruda logo abaixo do input */
    left: 0;
    z-index: 100;
    max-height: 350px; /* Limite de altura */
    overflow-y: auto;  /* Scroll se tiver muitos itens */
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
  }

  /* Personalização da barra de scroll para combinar com o Neon */
  .results-container::-webkit-scrollbar {
    width: 6px;
  }
  .results-container::-webkit-scrollbar-thumb {
    background: #6b21a8;
    border-radius: 3px;
  }

  .result-item {
    padding: 12px;
    border-bottom: 1px solid rgba(107, 33, 168, 0.3);
    transition: background 0.2s ease;
  }

  .result-item:hover {
    background: rgba(107, 33, 168, 0.1);
  }

  .result-item:last-child {
    border-bottom: none;
  }

  .result-item a {
    color: #06b6d4;
    display: block;
    text-decoration: none;
  }

  .result-item p {
    color: #9ca3af;
    font-size: 0.85rem;
    margin-top: 4px;
    line-height: 1.4;
  }

  .result-item mark {
    background: transparent;
    color: #ffffff;
    font-weight: bold;
    text-shadow: 0 0 5px #06b6d4;
  }

  .no-results {
    padding: 12px;
    color: #9ca3af;
    text-align: center;
  }
</style>
