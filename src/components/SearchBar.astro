---
// src/components/SearchBar.astro
---

<div class="search-wrapper">
  <div class="search-container">
    <input
      type="text"
      id="search-input"
      placeholder="Buscar..."
      class="neon-search"
      autocomplete="off"
      aria-label="Pesquisar no site"
    />

    <button class="search-btn" aria-label="Buscar" type="button">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>

  <!-- Resultados da pesquisa -->
  <div id="search-results" class="results-container"></div>
</div>

<script src="/search.js" is:inline></script>

<style>
  /* =========================
     ÁREA DA BUSCA
     ========================= */

  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    z-index: 1000;
  }

  .search-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .neon-search {
    box-sizing: border-box;
    width: 100%;
    height: 46px;

    padding: 0 48px 0 18px;

    background: rgba(10, 11, 16, 0.95);
    border: 2px solid #6b21a8;
    border-radius: 8px;

    color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;

    outline: none;

    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;

    box-shadow:
      0 0 10px rgba(107, 33, 168, 0.35),
      inset 0 0 5px rgba(107, 33, 168, 0.15);
  }

  .neon-search:hover {
    border-color: #8b2fc9;
  }

  .neon-search:focus {
    border-color: #06b6d4;

    box-shadow:
      0 0 15px rgba(6, 182, 212, 0.45),
      inset 0 0 8px rgba(6, 182, 212, 0.2);
  }

  .neon-search::placeholder {
    color: #6b7280;
    opacity: 1;
  }

  /* =========================
     BOTÃO DA LUPA
     ========================= */

  .search-btn {
    position: absolute;
    top: 50%;
    right: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 30px;
    height: 30px;

    padding: 0;

    transform: translateY(-50%);

    background: transparent;
    border: none;

    color: #6b21a8;
    cursor: pointer;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .search-btn:hover {
    color: #06b6d4;
    transform: translateY(-50%) scale(1.08);
  }

  .neon-search:focus + .search-btn {
    color: #06b6d4;
  }

  /* =========================
     CAIXA DE RESULTADOS
     ========================= */

  .results-container {
    display: none;

    position: absolute;
    top: calc(100% + 10px);
    left: 50%;

    width: 520px;
    max-width: 92vw;

    transform: translateX(-50%);

    box-sizing: border-box;

    background: rgba(10, 11, 16, 0.98);

    border: 1px solid #6b21a8;
    border-radius: 10px;

    overflow: hidden;
    overflow-y: auto;

    max-height: 320px;

    text-align: left;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.65),
      0 0 18px rgba(107, 33, 168, 0.2);

    backdrop-filter: blur(8px);

    scrollbar-width: thin;
    scrollbar-color: #6b21a8 transparent;
  }

  /* =========================
     SCROLLBAR
     ========================= */

  .results-container::-webkit-scrollbar {
    width: 6px;
  }

  .results-container::-webkit-scrollbar-track {
    background: transparent;
  }

  .results-container::-webkit-scrollbar-thumb {
    background: #6b21a8;
    border-radius: 10px;
  }

  .results-container::-webkit-scrollbar-thumb:hover {
    background: #8b2fc9;
  }

  /* =========================
     ITEM DE RESULTADO
     ========================= */

  .result-item {
    padding: 14px 16px;

    border-bottom: 1px solid rgba(107, 33, 168, 0.25);

    transition:
      background 0.2s ease,
      padding-left 0.2s ease;
  }

  .result-item:hover {
    background: rgba(107, 33, 168, 0.1);
    padding-left: 19px;
  }

  .result-item:last-child {
    border-bottom: none;
  }

  .result-item a {
    display: block;

    color: inherit;
    text-decoration: none;
  }

  /* =========================
     TÍTULO
     ========================= */

  .result-item h4 {
    margin: 0 0 6px;

    color: #06b6d4;

    font-size: 0.95rem;
    font-weight: 700;

    line-height: 1.35;

    transition: color 0.2s ease;
  }

  .result-item:hover h4 {
    color: #22d3ee;
  }

  /* =========================
     TRECHO DO RESULTADO
     ========================= */

  .result-item p {
    margin: 0;

    color: #9ca3af;

    font-size: 0.82rem;
    line-height: 1.45;

    /* Limita o tamanho do texto */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;

    overflow: hidden;
  }

  /* =========================
     TERMOS DESTACADOS
     ========================= */

  .result-item mark {
    padding: 1px 3px;

    background: #fde047;
    color: #111827;

    border-radius: 2px;

    font-weight: 700;
    text-shadow: none;
  }

  /* =========================
     NENHUM RESULTADO / ERRO
     ========================= */

  .no-results {
    margin: 0;
    padding: 18px;

    color: #9ca3af;

    font-size: 0.85rem;
    text-align: center;
  }

  /* =========================
     CELULAR
     ========================= */

  @media (max-width: 600px) {
    .search-wrapper {
      max-width: 100%;
    }

    .results-container {
      width: 94vw;
      max-height: 280px;
    }

    .neon-search {
      height: 44px;
      font-size: 0.9rem;
    }

    .result-item {
      padding: 12px 14px;
    }

    .result-item h4 {
      font-size: 0.9rem;
    }

    .result-item p {
      font-size: 0.8rem;
      -webkit-line-clamp: 2;
    }
  }
</style>
