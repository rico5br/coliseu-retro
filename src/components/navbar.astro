---
const helmetIcon = '/helmet-icon.png';
---

<header class="navbar">
  <div class="nav-container">
    
    <!-- Logo e Ícone Agrupados -->
    <div class="nav-brand-wrapper">
      <img 
        src={helmetIcon} 
        alt="Elmo Pixelado Neon" 
        class="nav-helmet-icon"
        width="32"
        height="32"
      />
      <a href="/" class="nav-logo">Coliseu Retro</a>
    </div>

    <nav class="nav-links">
      <a href="/">Início</a>
      <a href="/nintendo">Nintendo</a>
      <a href="/sega">Sega</a>
      <a href="/playstation">Playstation</a>
      <a href="/pc">PC</a>
      <a href="/arcade">Arcade</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    width: 100%;
    border-bottom: 1px solid rgba(107, 33, 168, 0.4);
    background-color: rgba(0, 0, 0, 0.9);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(5px);
  }

  .nav-container {
  width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 12px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .nav-brand-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-helmet-icon {
    display: block;
    height: 32px;
    width: auto;
    filter: drop-shadow(0 0 6px rgba(6, 182, 212, 0.5));
  }

  .nav-logo {
    font-weight: bold;
    color: var(--cyan-neon, #06b6d4);
    text-decoration: none;
    font-size: 1.1rem;
    text-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
    white-space: nowrap;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    color: #9ca3af;
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--cyan-neon, #06b6d4);
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      align-items: center;
      padding: 12px 10px;
      gap: 12px;
    }

    /* Força o bloco do logo a ocupar 100% e centralizar perfeitamente */
    .nav-brand-wrapper {
      width: 100%;
      justify-content: center;
      display: flex;
      align-items: center;
    }
    
    .nav-helmet-icon {
      height: 26px;
    }

    /* Centraliza e organiza os links abaixo do logo sem desalinhar */
    .nav-links {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px 16px; /* Espaçamento horizontal e vertical equilibrado */
    }
    
    .nav-links a {
      font-size: 0.85rem;
    }
  }
</style>
