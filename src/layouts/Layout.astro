---
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Coliseu Retrô</title>
	</head>
	<body>
    <Navbar />
		<slot />
    <Footer />
	</body>
</html>

<style>
  /* COLE O SEU CSS AQUI DENTRO DA TAG STYLE */
{
  box-sizing: border-box;
}
  :root {
    --bg-dark: #0a0b10;       
    --purple-accent: #6b21a8;  
    --cyan-neon: #06b6d4;     
    --text-main: #f3f4f6;     
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: 'Inter', sans-serif, system-ui;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--cyan-neon);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  a:hover {
    opacity: 0.8;
  }

  .btn-retro {
    background-color: var(--purple-accent);
    color: var(--text-main);
    border: 2px solid var(--cyan-neon);
    padding: 10px 20px;
    font-weight: bold;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
	
  }
  /* ... dentro do style existente ... */
  h1 {
    font-size: 3rem;
    margin-bottom: 10px;
    color: var(--cyan-neon);
    text-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    display: flex; /* Ajuda a alinhar o ícone */
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .pixel-icon {
    color: var(--purple-accent); /* Cor púrpura para o detalhe */
    font-family: monospace; /* Garante que fique quadrado */
    font-weight: bold;
  }
</style>
