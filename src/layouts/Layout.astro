---
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<!-- Garante o zoom inicial correto e escala para o dispositivo -->
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Coliseu Retrô</title>
	</head>
	<body>
    <Navbar />
		
		<!-- O data-pagefind-body avisa o Pagefind para indexar o conteúdo daqui de dentro -->
		<main data-pagefind-body>
			<slot />
		</main>

    <Footer />
	</body>
</html>

<style is:global>
	/* --- Reset e Normalização Total --- */
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	
	:root {
		--bg-dark: #0a0b10;        
		--purple-accent: #6b21a8;  
		--cyan-neon: #06b6d4;      
		--text-main: #f3f4f6;      
		--font-primary: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-dark);
		color: var(--text-main);
		font-family: var(--font-primary);
		overflow-x: hidden;
	}

	a {
		color: var(--cyan-neon);
		text-decoration: none;
		transition: opacity 0.2s;
		display: inline-block;
	}

	a:hover {
		opacity: 0.8;
	}

	.btn-retro {
		background-color: var(--purple-accent);
		color: var(--text-main);
		border: 2px solid var(--cyan-neon);
		padding: 12px 24px;
		font-weight: bold;
		border-radius: 4px;
		box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
		font-family: inherit;
		cursor: pointer;
	}
</style>
