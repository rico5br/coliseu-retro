---
import Layout from "../../layouts/Layout.astro";
import Cusdis from "../../components/Cusdis.astro";

const paginas = Array.from({ length: 46 }, (_, i) => i + 1);
---

<Layout title="Detonado de Chrono Cross">

  <main>

    <header class="cabecalho">

      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Coliseu Retro" class="logo" />
      </a>
      

      <h1>Detonado de Chrono Cross</h1>

      <p>
        Detonado completo de Chrono Cross para PlayStation.
      </p>

    

    </header>


    <section class="detonado">

  <div data-pagefind-body>

    <h2>Detonado de Chrono Cross</h2>

    <p>
      Detonado completo de Chrono Cross para PlayStation.
      Guia passo a passo do clássico.
    </p>

    {paginas.map((pagina) => (
      <img
        src={`/imagens/chrono-cross/${pagina}.jpg`}
        alt={`Página ${pagina} do detonado de Chrono Cross`}
      />
    ))}

  </div>

</section>

    <!-- Caixa de Comentários do Cusdis -->
    <section class="comentarios">
      <h2 class="comentarios-titulo">Comentários</h2>
      <Cusdis 
        id="detonado-chrono-cross" 
        url={pageUrl} 
        title={pageTitle} 
      />

</section>


    <div class="final">
      <p>— Fim do Detonado —</p>
      <a href="/" class="voltar">← Voltar para a página inicial</a>
    </div>

  </main>

</Layout>


<style>

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .cabecalho {
    text-align: center;
    margin-bottom: 50px;
  }

  h1 {
    color: #00eaff;
  }

  p {
    color: #aaa;
  }

  .detonado img {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto 30px;
  }

  .logo-link {
    display: block;
    width: fit-content;
    margin: 0 auto 20px;
  }

  .logo {
    width: 180px;
    height: auto;
    display: block;
    margin: 0 auto;
    transition: transform 0.2s ease;
  }

  .logo-link:hover .logo {
    transform: scale(1.05);
  }

  .voltar {
    display: block;
    width: fit-content;
    margin: 0 auto 30px;
    color: #00eaff;
    text-decoration: none;
  }

  .voltar:hover {
    color: #ff00ff;
    text-decoration: underline;
  }

  .final {
    text-align: center;
    padding: 20px 0 40px;
  }
.comentarios {
    margin: 60px auto 40px;
    max-width: 900px;
  }

  .comentarios-titulo {
    color: #00eaff;
    text-align: center;
    margin-bottom: 20px;
  }

</style>
